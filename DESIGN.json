      "html": "<div class=\"ds-media-cell\"><img src=\"https://picsum.photos/id/152/800/600\" alt=\"Sample image\"></div>",
      "css": ".ds-media-cell { background: #fff; border-radius: 12px; padding: 1rem; box-shadow: 0 4px 20px rgba(106, 27, 154, 0.12); border: 2px solid transparent; transition: transform 0.3s ease, box-shadow 0.3s ease; } .ds-media-cell:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0, 150, 136, 0.2); border-color: #26c6da; } .ds-media-cell img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; border-radius: 8px; }"
