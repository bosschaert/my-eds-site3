      "html": "<div class=\"ds-team-card\"><img src=\"https://randomuser.me/api/portraits/men/45.jpg\" alt=\"Team member 1\"><h4>Alex Johnson</h4><p>Project Lead with a knack for creative solutions and a love of adventure sports.</p></div>",
      "css": ".ds-team-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.07); width: 48%; padding: 1em; display: flex; flex-direction: column; align-items: center; } .ds-team-card img { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 1em; } .ds-team-card h4 { margin: 0.2em 0; } .ds-team-card p { font-size: 1.15rem; color: #5e35b1; text-align: center; font-weight: 500; }"
