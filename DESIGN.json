  "narrative": {
    "northStar": "Pastel Playground",
    "overview": "The site is a light, playful presentation surface. A soft diagonal gradient (cyan → lavender → cream) fills the whole page; everything that carries content sits on it as a white, softly shadowed card with generously rounded corners. Deep-purple serif headings with a faint drop shadow give the page a storybook tone, while the body copy stays a friendly medium-weight sans-serif in violet and charcoal.",
    "keyCharacteristics": [
      "Gradient canvas with white cards (12 px radius, tinted soft shadows)",
      "Deep-purple serif display headings, centered, with a 2 px text shadow",
      "Violet lede copy, centered, capped at 800 px",
      "Section-specific accents: teal + cyan (subheading), pink (prose block), blue (tabs)",
      "Circular 120 px portraits in a three-tab team roster"
    ],
    "rules": [
      {
        "name": "The Colour-Per-Section Rule",
        "body": "Each section owns one accent (teal/cyan, pink, blue); accents never travel between sections.",
        "section": "colors"
      },
      {
        "name": "The Centered Title Rule",
        "body": "Title and lede are centered; everything below is left-aligned.",
        "section": "typography"
      },
      {
        "name": "The Tinted Shadow Rule",
        "body": "Shadows take the hue of the section's accent (purple, pink, teal), never neutral black at full strength.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the 135° three-stop gradient on the body and white cards on top of it.",
      "Do keep the h1 text shadow and the −0.5px tracking.",
      "Do keep the source font stacks verbatim; no font files are loaded today."
    ],
    "donts": [
      "Don't introduce a logo, favicon or hamburger menu; none exist.",
      "Don't add ARIA tab roles or new states beyond .active; the tabs are plain buttons.",
      "Don't flatten the tinted shadows to neutral grey."
    ]
  }
