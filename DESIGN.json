      "html": "<button class=\"ds-tab ds-tab--active\">Team Alpha</button>",
      "css": ".ds-tab { background: none; border: none; padding: 1em 2em; cursor: pointer; font-size: 1.1em; font-weight: bold; color: #666; transition: color 0.2s; } .ds-tab--active { color: #2196F3; border-bottom: 3px solid #2196F3; background: #fff; }"
