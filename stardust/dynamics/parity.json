{
  "site": "https://current-design.jp/",
  "features": [
    {
      "id": "menu-overlay",
      "class": "M",
      "disposition": "rebuild-native",
      "checks": [
        {
          "type": "dom-count",
          "path": "/",
          "selector": "dialog.menu-dialog a",
          "min": 10
        }
      ],
      "feature": "Site menu overlay (mobile)",
      "note": "the burger shows below 768 px only (as on the source); its open/close flow is asserted by the header contract at 390 (chrome-compare: toggle click+key, 10/10 links); dynamics-check runs at 1440"
    },
    {
      "id": "hero-carousel",
      "class": "M",
      "disposition": "rebuild-native",
      "checks": [
        {
          "type": "dom-count",
          "path": "/",
          "selector": ".hero img",
          "min": 4
        }
      ],
      "feature": "Hero carousel"
    }
  ]
}
