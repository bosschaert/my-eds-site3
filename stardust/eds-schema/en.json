  },
  {
   "section": "section",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Products"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Doosan Bobcat builds the most reliable compact equipment and attachments to help customers conquer their toughest jobs."
    },
    {
     "role": "body",
     "order": 2,
     "text": "Drag"
    },
    {
     "role": "heading",
     "order": 3,
     "text": "Compact Equipment"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Doosan Bobcat leads the industry in the design, manufacturing, marketing and distribution of compact equipment for construction, landscaping, agriculture, grounds maintenance, utility and mining industries. Committed to empowering people to accomplish more, Doosan Bobcat is dedicated to building stronger communities for a better tomorrow."
    },
    {
     "role": "body",
     "order": 5,
     "text": "Learn more"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Learn more"
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Material Handling"
    },
    {
     "role": "body",
     "order": 8,
     "text": "We emphasizes operator convenience, equipment performance and eco-friendly features such as reduced noise and emissions."
    },
    {
     "role": "body",
     "order": 9,
     "text": "Learn more"
    },
    {
     "role": "body",
     "order": 10,
     "text": "Learn more"
    },
    {
     "role": "heading",
     "order": 11,
     "text": "Portable Power"
    },
    {
     "role": "body",
     "order": 12,
     "text": "We provides durable and reliable air compressors, generators and light towers that are built to last, easy to operate and ready to perform on demand."
    },
    {
     "role": "body",
     "order": 13,
     "text": "Learn more"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Learn more"
    }
   ],
