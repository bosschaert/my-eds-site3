  {
   "section": "section",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "DOOSAN BOBCAT"
    },
    {
     "role": "body",
     "order": 1,
     "text": "As the inventor of the world's first skid-steer loader, Doosan Bobcat is a leading global manufacturer and distributor of premium brands leading multiple industry segments."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "History of Doosan Bobcat",
     "href": "/en/about/history"
    },
    {
     "role": "body",
     "order": 3,
     "text": "We invented the original skid- steer loader and produced our millionth loader in 2014. More Bobcat® skid-steer loaders are at work around the world than all the other brands combined."
    },
    {
     "role": "body",
     "order": 4,
     "text": "We offer the most attachments (100+ categories) in the industry."
    },
    {
     "role": "body",
     "order": 5,
     "text": "We have 1500+ dealerships in North America, delivering industry-leading support to customers in their local communities."
    },
    {
     "role": "body",
     "order": 6,
     "text": "We introduced the world's first all-electric compact loaders, as we innovate for the future."
    }
   ],
   "imgCount": 4,
   "editableTexts": 3,
   "repeats": [
    {
