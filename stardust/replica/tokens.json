  "type": {
    "declared-stacks": {
      "body": "'Gotham-Light', sans-serif",
      "headings": "inherit from body (Bootstrap h1-h6 font-family: inherit); GothamBold where style.css names it",
      "hero-h2": "'Gotham Bold', Helvetica, Arial, Lucida, sans-serif",
      "buttons": "'GothamMedium' (no generic fallback)",
      "top-menu": "'GothamMedium'",
      "note": "AMENDED (recreate): style.css imports ../fonts/font.css, which declares GothamBold, GothamBook, GothamMedium (woff2/woff/ttf) and Gotham-Light (+Italic, woff/ttf) as self-hosted faces — licensed commercial kit, not rehosted. Substitutes: Montserrat 400/500/700 registered as 'Gotham-Light Substitute' / 'GothamMedium Substitute' / 'GothamBold Substitute' (single normal weight each, mirroring the source's single-weight blocks so font-weight:700 synthesizes bold on both sides). Width ratios vs Gotham: 0.99 / 0.98 / 1.01."
    },
    "declared-loaded-faces": {
      "google-fonts": [
        "Libre Baskerville 400",
        "Open Sans 400",
        "Open Sans 700 (+ Open Sans 300-800 via a second link)"
      ],
      "used-by-census": "none of the measured headings/text/buttons compute to these families",
      "icon-fonts": [
        "FontAwesome (social icons .fa)",
        "dashicons",
        "esf-custom-icons",
        "revicons"
      ]
    },
    "ramp": {
      "body": {
        "size": "1rem",
        "lineHeight": 1.5,
        "weight": 400
      },
      "h1": {
        "size": "2.5rem",
        "weight": 500,
        "lineHeight": 1.2,
        "marginBottom": ".5rem"
      },
      "h2": {
        "size": "2rem",
        "weight": 500,
        "lineHeight": 1.2,
        "transform": "uppercase",
        "color": "#3c3c3c"
      },
      "h3": {
        "size": "1.75rem",
        "weight": 500,
        "lineHeight": 1.2
      },
      "h4": {
        "size": "1.5rem",
        "weight": 500,
        "lineHeight": 1.2,
        "censusNote": "census saw 19.2px (1.2rem) on 8 headings — verify per element with measure.mjs"
      },
      "hero-h2": {
        "size": "1.5rem",
        "weight": 700,
        "letterSpacing": "1px",
        "lineHeight": "1.2em",
        "marginTop": "2rem",
        "color": "#f9ec31",
        "align": "center"
      },
      "nav-item": {
        "size": "0.9rem",
        "media": {
          "(min-width:1200px) and (max-width:1469px)": "0.75rem, margin 0 .1rem"
        }
      },
      "card-p": {
        "size": "0.9rem",
        "color": "#333"
      },
      "small": "80%",
      "census-sizes-px": [
        32,
        28,
        20,
        19.2,
        16,
        12
      ]
    },
    "text-rendering": {
      "html": "sans-serif base, line-height 1.15, -webkit-text-size-adjust 100%",
      "smoothing": "not set"
    },
    "substitutes": {
      "Gotham-Light": "montserrat-latin-400-normal.woff2",
      "GothamMedium": "montserrat-latin-500-normal.woff2",
      "GothamBold": "montserrat-latin-700-normal.woff2",
      "source": "https://cdn.jsdelivr.net/npm/@fontsource/montserrat (OFL)"
    }
  },
  "layout": {
