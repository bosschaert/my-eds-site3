        "768": "720px",
        "992": "960px",
        "1200": "1140px"
      }
    },
    "container-fluid": "width 100%, padding 0 15px",
    "row": "flex wrap, margin 0 -15px; columns padding 0 15px",
    "container-offset": "max-width calc(1140px + (100vw - 1140px)/2), margin-left auto",
    "section": {
